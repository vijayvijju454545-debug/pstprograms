class Solution:
    def daysBetweenDates(self, date1, date2):
        from datetime import date

        y1, m1, d1 = map(int, date1.split("-"))
        y2, m2, d2 = map(int, date2.split("-"))

        date1 = date(y1, m1, d1)
        date2 = date(y2, m2, d2)

        return abs((date1 - date2).days)
